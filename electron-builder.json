{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.platelifecycle.app",
  "productName": "Plate Lifecycle Management System",
  "copyright": "Copyright © 2026 Plate Lifecycle Management System",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Plate Lifecycle Management System"
  },
  "portable": {
    "artifactName": "PlateLifecycle-Portable-Windows-x64.exe"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "build/icons/icon.icns"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "build/icons/icon.png"
  }
}
